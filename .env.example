# ==========================================================================
# .env.example — copie para .env e preencha. NUNCA commite o .env real.
# ==========================================================================

# --- Banco ---
# PADRÃO: SQLite LOCAL — arquivo dev.db na pasta do backend, criado e migrado
# automaticamente no startup. Não precisa de servidor nem credenciais.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
#
# OPCIONAL — Postgres (ex.: deploy em produção). O scheme PRECISA ser
# postgresql+asyncpg:// (driver async). Nesse caso aplique docs/schema.sql uma vez.
# DATABASE_URL=postgresql+asyncpg://USUARIO:SENHA@HOST:5432/postgres

# --- Apollo.io ---
# Settings > Integrations > API > Create New Key
APOLLO_API_KEY=cole_sua_chave_aqui
APOLLO_BASE_URL=https://api.apollo.io/v1
APOLLO_RATE_LIMIT=46            # requisições por minuto (margem sobre o limite do plano)
APOLLO_MIN_INTERVAL_MS=1300     # intervalo mínimo entre chamadas (derivado do rate limit)

# --- ViaCEP (gratuito, sem chave) ---
VIACEP_BASE_URL=https://viacep.com.br/ws
VIACEP_RATE_LIMIT=120           # requisições por minuto

# --- Google Maps Platform (Places + Geocoding) ---
# Google Cloud Console > APIs & Services > Credentials > Create API key.
# Habilite as APIs "Places API" e "Geocoding API" e ATIVE o billing no projeto.
# Provider "google_maps": reverse-lookup do telefone (E.164) + geocoding de endereço.
GOOGLE_MAPS_API_KEY=cole_sua_chave_aqui
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api
GOOGLE_MAPS_RATE_LIMIT=600           # requisições por minuto (~10 QPS)
GOOGLE_MAPS_PLACE_DETAILS=true       # chamada extra de Place Details no match por telefone

# --- HTTP ---
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# --- Enriquecimento ---
ENRICH_CHECKPOINT_EVERY=25      # salva checkpoint a cada N leads
ENRICH_BATCH_SIZE=500           # tamanho do lote no import (upsert)
DEFAULT_PHONE_COUNTRY=BR

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50                # limite de tamanho do arquivo no /leads/import

# --- CORS ---
# Origens permitidas quando o frontend roda em domínio DIFERENTE do backend.
# Em dev com o proxy do Vite (same-origin) isto é inócuo. Lista separada por vírgula.
CORS_ORIGINS=http://localhost:5173
